# ==============================================================================
# TELEGRAM BOT CONFIGURATION
# ==============================================================================
BOT_TOKEN=PUT_YOUR_TELEGRAM_BOT_TOKEN_HERE
ADMIN_USER_ID=PUT_YOUR_TELEGRAM_ADMIN_USER_ID_HERE
ADMIN_CHAT_ID=PUT_THE_SAME_PRIVATE_CHAT_ID_HERE

# Backward-compatible fallback only. Prefer ADMIN_USER_ID + ADMIN_CHAT_ID.
# ADMIN_ID=PUT_YOUR_TELEGRAM_ADMIN_ID_HERE

# ==============================================================================
# KASPA NODE & DATABASE
# ==============================================================================
NODE_URL_01=wss://your-kaspa-node.example.com/json

# Runtime must use a least-privilege application role, not the postgres superuser.
DATABASE_URL=postgres://kaspa_pulse_app:PUT_APP_PASSWORD_HERE@127.0.0.1:5433/kaspa_dev?sslmode=disable
DB_MAX_CONNECTIONS=10
ALLOW_RUNTIME_SCHEMA_ENSURE=false

# ==============================================================================
# PRODUCTION SETTINGS
# ==============================================================================
APP_ENV=production
RUST_LOG=info
ENABLE_VERBOSE_LOGS=false
SQLX_OFFLINE=true
HTTP_TIMEOUT_SECS=10
HTTP_CONNECT_TIMEOUT_SECS=5
RPC_TIMEOUT_SECS=15
SHUTDOWN_DRAIN_SECS=3
PRICE_API_CIRCUIT_COOLDOWN_SECS=300

# Optional panic-recovery marker override for non-container deployments.
# Docker images provide a writable default under /var/lib/kaspa-pulse.
# PANIC_EVENT_MARKER_PATH=/var/lib/kaspa-pulse/panic_event_pending.json

# ==============================================================================
# TELEGRAM PROTECTION
# ==============================================================================
MAX_WALLETS_PER_USER=10
RATE_LIMIT_COMMANDS_PER_SECOND=1
RATE_LIMIT_CALLBACKS_PER_SECOND=3
RATE_LIMIT_ADD_WALLET_PER_MINUTE=5
MAX_RAW_MESSAGE_CHARS=512
MAX_WALLET_ADDRESS_CHARS=120
LOG_MAX_CHARS=3000

# ==============================================================================
# ALERT DELIVERY
# ==============================================================================
ENABLE_TELEGRAM_DELIVERY_QUEUE=true
ENABLE_ALERT_DELIVERY=true
MIN_REWARD_CONFIRMATIONS=10
DELIVERY_QUEUE_METRICS_INTERVAL_SECS=30

# ==============================================================================
# WEBHOOK SETTINGS
# Keep USE_WEBHOOK=false when using Telegram polling.
# ==============================================================================
USE_WEBHOOK=false
WEBHOOK_DOMAIN=your-domain.com
WEBHOOK_PORT=8443
WEBHOOK_BIND=127.0.0.1
WEBHOOK_SECRET_TOKEN=PUT_RANDOM_32_PLUS_CHAR_SECRET_HERE
WEBHOOK_MAX_CONNECTIONS=20
WEBHOOK_ALLOW_PUBLIC_BIND=false

# ==============================================================================
# HEALTH / READINESS / METRICS
# ==============================================================================
HEALTH_ENDPOINT_ENABLED=true
HEALTH_BIND=127.0.0.1
HEALTH_PORT=18080
HEALTH_ALLOW_PUBLIC_BIND=false
READINESS_REQUIRE_NODE=true
# Effective only when KASPA_MONITOR_MODE=subscription_preferred.
READINESS_REQUIRE_SUBSCRIPTION=true
READINESS_MAX_SCAN_AGE_SECS=120
# Only terminal failures updated inside this rolling window affect readiness.
# Historical failed rows remain visible in kaspa_pulse_queue_failed.
READINESS_FAILED_QUEUE_WINDOW_SECS=3600
READINESS_MAX_FAILED_QUEUE_ITEMS=0

# ==============================================================================
# EVENT / HISTORY RETENTION
# ==============================================================================
BOT_EVENT_LOG_RETENTION_DAYS=60
BLOCKS_HISTORY_PAGE_SIZE=15

# ==============================================================================
# MARKET DATA
# ==============================================================================
COINGECKO_API_URL=https://api.coingecko.com/api/v3/simple/price?ids=kaspa&vs_currencies=usd&include_market_cap=true
KASPA_API_PRICE_URL=https://api.kaspa.org/info/price
KASPA_API_MCAP_URL=https://api.kaspa.org/info/marketcap
COINGECKO_MARKET_CHART_RANGE_URL=https://api.coingecko.com/api/v3/coins/kaspa/market_chart/range
KAS_PRICE_HISTORY_ENABLED=true
KAS_PRICE_REFRESH_INTERVAL_SECS=3600
KAS_PRICE_BACKFILL_LIMIT_DAYS=180

# ==============================================================================
# KASPA MONITORING RUNTIME
# subscription_preferred uses native notifications with polling fallback.
# polling_only disables native notification registration.
# ==============================================================================
KASPA_MONITOR_MODE=subscription_preferred
KASPA_MONITOR_POLL_INTERVAL_SECS=10
KASPA_MONITOR_RECONCILIATION_INTERVAL_SECS=60
KASPA_SUBSCRIPTION_MIN_SCAN_INTERVAL_SECS=2
KASPA_SUBSCRIPTION_RETRY_SECS=30
KASPA_SUBSCRIPTION_SUPERVISOR_RESTART_SECS=5
